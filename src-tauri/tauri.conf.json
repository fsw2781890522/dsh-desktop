{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.2.2",
  "identifier": "com.deepseek.harness.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop app",
    "longDescription": "The official DeepSeek Harness Web UI wrapped as a Windows desktop application with Tauri. The app bundles Node.js and the DeepSeek Harness CLI and serves the Web UI on 127.0.0.1 inside a native window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundle-runtime.zip": "bundle-runtime.zip"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
